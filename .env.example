# ---------------------------------------------------------------------------------------------------------------
# Copy to .env (`cp .env.example .env`) before `docker compose up`. Every environment-specific value is injected
# from here at runtime; the code contains no endpoints, credentials or model identifiers. Never commit .env.
# ---------------------------------------------------------------------------------------------------------------

# --- Internal service endpoints (Docker Compose service names; change only if you rename services) -------------
REDIS_URL=redis://redis:6379/0
RETRIEVER_URL=http://retriever:8000
LLM_GATEWAY_URL=http://llm-gateway:8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Link shown in the web client next to each run (the Jaeger UI as seen from your browser)
JAEGER_UI_URL=http://localhost:16686

# --- Model provider (behind the llm-gateway; switching provider is a config change) --------------------------
# Default: the bundled stub (fixed responses after a realistic delay). Works with no key; used for load tests.
LLM_PROVIDER=stub
LLM_BASE_URL=http://llm-stub:8000/v1
LLM_MODEL=stub-fixed-v1
LLM_API_KEY=
# Real provider example (Google Gemini free tier, OpenAI-compatible endpoint). Uncomment and fill in:
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=<your key from aistudio.google.com>
# Price used to record cost at call time (USD per 1M tokens). Set to your provider's list price even on a free tier,
# so cost per run is meaningful.
LLM_PRICE_PROMPT_PER_1M_USD=0.10
LLM_PRICE_COMPLETION_PER_1M_USD=0.40
LLM_DAILY_BUDGET_USD=5
LLM_PROVIDER_TIMEOUT_S=20
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_SECONDS=30

# --- LLM stub (only used when LLM_PROVIDER=stub) -------------------------------------------------------------
STUB_LATENCY_MS=800
STUB_LATENCY_JITTER=0.35

# --- Embeddings ------------------------------------------------------------------------------------------------
# sentence-transformers runs locally on CPU (no cost). The model is downloaded on first start into the data volume.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# If the model cannot be downloaded, fall back to deterministic hashing embeddings instead of failing to start.
EMBEDDING_ALLOW_FALLBACK=true

# --- Agent limits and behaviour ----------------------------------------------------------------------------------
AGENT_MAX_STEPS=14
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_WALL_S=90
AGENT_MAX_VERIFY_ATTEMPTS=2
PLANNER_MODE=hybrid
DETERMINATION_MODE=hybrid
ENABLE_MODIFIER_SEARCH=true
FIND_RELATED_RELATIONS=referenced_by_this,cites_this,cites_parent
DERIVED_K=3
WORKER_CONCURRENCY=4
RUN_DEADLINE_S=120
LLM_CALL_TIMEOUT_S=25
LLM_MAX_RETRIES=2
RETRY_BASE_DELAY_S=0.5
TOOL_TIMEOUT_S=5

# --- Prompt versions (prompts/<id>/<version>.yaml) ------------------------------------------------------------
PROMPT_VERSION_EXTRACTION=v1
PROMPT_VERSION_PLANNER=v1
PROMPT_VERSION_DETERMINATION=v2

# --- API: rate limiting and caching -------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
MAX_INFLIGHT_PER_CLIENT=200
RUN_CACHE_ENABLED=true
RUN_CACHE_TTL_S=86400
RETRIEVAL_CACHE_ENABLED=true
LIVE_EVAL_SAMPLE_RATE=0.25
CLAIM_MAX_AGE_DAYS=730

# --- Observability -----------------------------------------------------------------------------------------
LOG_LEVEL=INFO
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
