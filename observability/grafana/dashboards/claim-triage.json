   "id": 1,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Run latency, submission to result (p50 / p95)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(run_e2e_seconds_bucket[1m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(run_e2e_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Throughput",
   "description": "",
